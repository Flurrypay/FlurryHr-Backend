DATABASE_URL=postgresql://flurryhr:flurryhr_local@localhost:5432/flurryhr?schema=public
PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
COMPANY_TIMEZONE=Africa/Lagos
# Required for the initial admin account. Never commit this value.
SEED_ADMIN_EMAIL=admin@flurrypay.com
SEED_ADMIN_PASSWORD=

# Required: generate a stable 32-byte secret as 64 hex characters. The setup helper creates it locally.
MAIL_ENCRYPTION_KEY=
# Only NODE_ENV=test may use MAIL_TRANSPORT=file and TEST_MAIL_DIR.
MAIL_TRANSPORT=zoho
# Platform administrators are provisioned only through the platform:provision CLI.
# Use a dedicated email, separate from the company seed; password must be at least 16 characters.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Private storage must be durable and backed up in production.
DOCUMENT_STORAGE_DIR=.local/documents
API_HOST=127.0.0.1

# Zoho ZeptoMail HTTP API: use the endpoint shown in your Zoho account.
ZOHO_EMAIL_API_URL=
ZOHO_EMAIL_API_KEY=
ZOHO_EMAIL_FROM=

# Optional AWS biometric attendance integration. Leave company requirement off until live-tested.
# Standard AWS SDK credential chain stays backend-only (prefer a server IAM role).
AWS_FACE_REGION=us-east-1
AWS_FACE_STREAM_ROLE_ARN=
# Separate 32-byte hex key; preserve securely across deploys and backups. Never put in VITE_*.
BIOMETRIC_ENCRYPTION_KEY=
FACE_LIVENESS_THRESHOLD=95
FACE_MATCH_THRESHOLD=99
